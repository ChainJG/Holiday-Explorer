<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MaxWidth" Value="300" />

        <!--  Centre tooltip under the attached control.  -->
        <Setter Property="HorizontalOffset">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource ToolTipCenterOffsetConverter}">
                    <Binding Path="PlacementTarget.ActualWidth" RelativeSource="{RelativeSource Self}" />
                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border
                        MaxWidth="{TemplateBinding MaxWidth}"
                        Padding="8,5"
                        Background="{StaticResource PrimaryPanelColour}"
                        BorderBrush="{StaticResource SecondaryPanelColour}"
                        BorderThickness="1"
                        CornerRadius="5">

                        <TextBlock
                            MaxWidth="{TemplateBinding MaxWidth}"
                            Style="{StaticResource ButtonSubTitleStyle}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                            TextWrapping="Wrap" />

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>