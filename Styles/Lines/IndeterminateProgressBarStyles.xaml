<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Holiday_Explorer.MVVM.AttachedProperties">

    <!--  Four-colour flowing indeterminate progress bar.  -->
    <Style x:Key="GameBoostLoopProgressBarStyle" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{StaticResource GreenColour}" />
        <Setter Property="Background" Value="{StaticResource ButtonMouseOver}" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">

                    <Grid Height="{TemplateBinding Height}" ClipToBounds="True">

                        <Border CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ui:CornerRadiusAssist.CornerRadius)}">

                            <Border.Background>
                                <LinearGradientBrush SpreadMethod="Repeat" StartPoint="0,0" EndPoint="1,0">

                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="FourColourGradientTransform" X="-1" />
                                    </LinearGradientBrush.RelativeTransform>

                                    <GradientStop Offset="0.00" Color="#f2d146" />
                                    <GradientStop Offset="0.40" Color="#e28c41" />
                                    <GradientStop Offset="0.50" Color="#d13b63" />
                                    <GradientStop Offset="0.70" Color="#e28c41" />
                                    <GradientStop Offset="1.00" Color="#f2d146" />

                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FourColourProgressStoryboard">
                                    <Storyboard RepeatBehavior="Forever">

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FourColourGradientTransform" Storyboard.TargetProperty="X">

                                            <SplineDoubleKeyFrame KeyTime="0:0:0" Value="-1" />

                                            <SplineDoubleKeyFrame
                                                KeySpline="0.22,0.61 0.36,1"
                                                KeyTime="0:0:0.65"
                                                Value="-0.30" />

                                            <!--  The bright colour slows near the centre.  -->
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.45,0 0.55,1"
                                                KeyTime="0:0:1.65"
                                                Value="0.15" />

                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0 0.2,1"
                                                KeyTime="0:0:2.35"
                                                Value="0.70" />

                                            <SplineDoubleKeyFrame
                                                KeySpline="0.22,0.61 0.36,1"
                                                KeyTime="0:0:3"
                                                Value="1" />

                                        </DoubleAnimationUsingKeyFrames>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FourColourProgressStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>