<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>HolidayExplorer.WebHost</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\HolidayExplorer.Core\HolidayExplorer.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\Data\airports.json">
			<Link>Data\airports.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		
		<Content Include="..\Data\holidays.seed.json">
			<Link>Data\holidays.seed.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Content Update="wwwroot\data\airports.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

</Project>